{
  "liveServer.settings.port": 5500,
  "liveServer.settings.host": "localhost",
  "liveServer.settings.useLocalIp": false,
  // a Wardro valójában a saját szerverén fut (http://localhost:8080); a "Go Live"
  // által megnyitott oldal (Wardro Web.dc.html) magától átvált oda, amint a szerver elérhető.
  // Proxy nincs, mert ha a 8080 még nem fut, a proxyval csak hibaoldal jönne be.
  "liveServer.settings.file": "Wardro Web.dc.html",
  "liveServer.settings.proxy": {
    "enable": false,
    "baseUri": "/",
    "proxyUri": "http://localhost:8080"
  }
}
