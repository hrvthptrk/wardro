{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Helyi szerver indítása (8080)",
            "type": "shell",
            "command": "node",
            "args": ["${workspaceFolder}/server/index.js"],
            "options": { "cwd": "${workspaceFolder}/server" },
            "isBackground": true,
            // a mappa megnyitásakor magától elindul (ha a 8080 már foglalt, csendben kilép)
            "runOptions": { "runOn": "folderOpen" },
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated"
            },
            "problemMatcher": {
                "pattern": {
                    "regexp": "^(soha nem illeszkedő minta)$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^Kiszolgálás indul",
                    "endsPattern": "^Kiszolgálás fut"
                }
            }
        }
    ]
}
