{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Helyi szerver indítása (8080)",
            "type": "shell",
            "command": "node",
            "args": ["${workspaceFolder}/.vscode/serve.js"],
            "isBackground": true,
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated"
            },
            "problemMatcher": {
                "pattern": {
                    "regexp": "^(soha nem illeszkedő minta)$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^Kiszolgálás indul",
                    "endsPattern": "^Kiszolgálás fut"
                }
            }
        }
    ]
}
