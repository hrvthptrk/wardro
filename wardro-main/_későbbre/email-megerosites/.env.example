# Másold le ezt a fájlt .env néven (server/.env), és töltsd ki.
# Ha nincs .env, az igazoló linkek csak a szerver konzoljára íródnak ki.

# Gmail esetén: a Google-fiókban kapcsold be a kétlépcsős azonosítást, majd
# hozz létre egy "alkalmazásjelszót" (myaccount.google.com/apppasswords),
# és azt írd az SMTP_PASS-hoz (NEM a rendes Gmail jelszavad).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=sajat.cimed@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx
MAIL_FROM=Wardro <sajat.cimed@gmail.com>
